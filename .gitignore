:root {
  --pink-100: #fff0f5;
  --pink-300: #ffcfe0;
  --pink-500: #f8b6cf;
  --lavender-200: #efe7ff;
  --lavender-400: #d9c7ff;
  --mint-200: #dff8eb;
  --mint-400: #bde9d2;
  --vanilla-100: #fff9ee;
  --vanilla-300: #f6e6bf;
  --text-900: #2d2430;
  --text-700: #5d5365;
  --shadow: rgba(84, 63, 76, 0.12);
  --white: #fff;
  --danger: #d85757;
  --success: #2d9d74;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Nunito', sans-serif;
  background: linear-gradient(180deg, var(--vanilla-100) 0%, #fff 100%);
  color: var(--text-900);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  max-width: 100%;
  display: block;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 15;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 1rem 4rem;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(108, 90, 120, 0.08);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--pink-500), var(--lavender-400));
  display: grid;
  place-items: center;
  color: var(--white);
  font-weight: 800;
  box-shadow: 0 12px 24px rgba(173, 135, 205, 0.25);
}

.brand-name {
  font-weight: 800;
}

.brand-sub {
  font-size: 0.76rem;
  color: var(--text-700);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.nav-links button {
  border: none;
  background: transparent;
  color: var(--text-900);
  font-weight: 700;
}

.primary-btn,
.secondary-btn {
  border: none;
  border-radius: 999px;
  padding: 0.8rem 1.4rem;
  font-weight: 800;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--pink-500), var(--lavender-400));
  color: var(--text-900);
  box-shadow: 0 14px 24px rgba(190, 87, 159, 0.22);
}

.secondary-btn {
  background: var(--white);
  color: var(--text-900);
  border: 1px solid rgba(63, 54, 70, 0.1);
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-2px);
}

.small-btn {
  padding: 0.7rem 1.1rem;
  font-size: 0.9rem;
}

.cart-pill {
  padding-inline: 1.1rem;
}

.section-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 2rem;
  padding-top: 4rem;
}

.hero-copy h1 {
  font-size: clamp(2.5rem, 4vw, 4.4rem);
  line-height: 1.05;
  margin: 0.6rem 0 1rem;
}

.hero-copy p,
.about-copy p,
.card-body p,
.contact-card p {
  color: var(--text-700);
  line-height: 1.7;
}

.eyebrow {
  display: inline-flex;
  background: rgba(248, 182, 207, 0.18);
  border-radius: 999px;
  padding: 0.4rem 0.8rem;
  color: var(--text-900);
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.04rem;
  text-transform: uppercase;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 1.7rem;
}

.hero-visual img {
  width: 100%;
  min-height: 420px;
  object-fit: cover;
  border-radius: 32px;
  box-shadow: 0 26px 60px rgba(167, 140, 177, 0.2);
}

.section-heading {
  margin-bottom: 2rem;
}

.section-heading h2 {
  margin: 0.6rem 0 0;
  font-size: clamp(2rem, 3vw, 2.8rem);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
}

.product-card {
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(73, 58, 81, 0.06);
  overflow: hidden;
  box-shadow: 0 16px 30px var(--shadow);
}

.image-wrap {
  height: 260px;
  overflow: hidden;
}

.image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.product-card:hover .image-wrap img {
  transform: scale(1.04);
}

.card-body {
  padding: 1rem 1.1rem 1.3rem;
}

.card-topline {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: center;
  margin-bottom: 0.4rem;
}

.card-topline h3,
.cart-item-info h3,
.modal-card h3,
.confirmation-card h2 {
  margin: 0;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 0.6rem 0 0.8rem;
  color: var(--text-700);
  font-size: 0.92rem;
}

.status {
  display: inline-block;
  background: rgba(45, 157, 116, 0.12);
  border-radius: 999px;
  padding: 0.25rem 0.6rem;
  font-size: 0.75rem;
  color: var(--success);
}

.status.unavailable {
  background: rgba(216, 87, 87, 0.12);
  color: var(--danger);
}

.offer-grid,
.testimonial-grid,
.footer-grid,
.contact-layout {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.4rem;
}

.offer-item,
.testimonial-grid blockquote,
.contact-card,
.contact-form,
.checkout-form-card,
.checkout-summary,
.confirmation-card,
.cart-summary {
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(79, 59, 79, 0.06);
  border-radius: 24px;
  box-shadow: 0 14px 26px var(--shadow);
}

.offer-item {
  padding: 1.5rem;
}

.offer-tag {
  display: inline-block;
  background: var(--mint-200);
  color: var(--text-900);
  font-size: 0.72rem;
  font-weight: 800;
  padding: 0.4rem 0.7rem;
  border-radius: 999px;
}

.testimonial-grid blockquote {
  margin: 0;
  padding: 1.5rem;
  color: var(--text-700);
  line-height: 1.7;
}

.about {
  display: grid;
  grid-template-columns: 1fr;
}

.hours-card {
  margin-top: 1.5rem;
  background: linear-gradient(135deg, rgba(255, 240, 245, 0.8), rgba(223, 248, 235, 0.7));
  border-radius: 24px;
  padding: 1.5rem;
}

.filters-row {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr 0.8fr;
  gap: 1rem;
  margin-bottom: 2rem;
}

.filters-row input,
.filters-row select,
.checkout-form-card input,
.checkout-form-card textarea,
.contact-form input,
.contact-form textarea {
  width: 100%;
  border: 1px solid rgba(71, 53, 70, 0.1);
  background: var(--white);
  border-radius: 14px;
  padding: 0.9rem 1rem;
  color: var(--text-900);
}

.state-box {
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(78, 65, 82, 0.08);
  padding: 1.4rem;
  color: var(--text-700);
}

.error-box {
  background: rgba(216, 87, 87, 0.08);
  color: var(--danger);
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(41, 31, 46, 0.5);
  display: grid;
  place-items: center;
  padding: 2rem;
  z-index: 30;
}

.modal-card {
  position: relative;
  width: min(900px, 90vw);
  background: var(--white);
  border-radius: 28px;
  padding: 1.5rem;
}

.close-btn {
  position: absolute;
  top: 1rem;
  right: 1rem;
  border: none;
  background: #f7e9f1;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 1.5rem;
}

.modal-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  align-items: center;
}

.modal-layout img {
  width: 100%;
  height: 350px;
  object-fit: cover;
  border-radius: 18px;
}

.price-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 1rem 0;
}

.cart-layout,
.checkout-layout {
  display: grid;
  grid-template-columns: 1.7fr 0.9fr;
  gap: 1.5rem;
}

.cart-items {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.cart-item {
  display: grid;
  grid-template-columns: 90px 1.3fr 0.7fr 0.9fr 0.7fr;
  align-items: center;
  gap: 1rem;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(79, 59, 79, 0.06);
  border-radius: 22px;
  padding: 1rem;
}

.cart-item img {
  width: 90px;
  height: 90px;
  object-fit: cover;
  border-radius: 18px;
}

.quantity-control {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  background: var(--vanilla-100);
  border-radius: 999px;
  padding: 0.3rem 0.7rem;
}

.quantity-control button {
  width: 28px;
  height: 28px;
  border: none;
  border-radius: 50%;
  background: var(--white);
}

.line-total {
  font-weight: 800;
}

.remove-btn {
  border: none;
  background: #fdeaea;
  color: var(--danger);
  border-radius: 10px;
  padding: 0.6rem 0.8rem;
}

.cart-summary,
.checkout-summary,
.contact-card,
.contact-form,
.checkout-form-card,
.confirmation-card {
  padding: 1.5rem;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 0.8rem;
}

.total-row {
  font-size: 1.1rem;
  border-top: 1px solid rgba(53, 38, 52, 0.08);
  padding-top: 0.9rem;
  margin-top: 0.8rem;
}

.full-width {
  width: 100%;
  margin-top: 1rem;
}

.checkout-form-card,
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.checkout-form-card label,
.contact-form label {
  display: flex;
  flex-direction: column;
  gap: 0.42rem;
  font-weight: 700;
}

.checkout-form-card textarea,
.contact-form textarea {
  min-height: 120px;
  resize: vertical;
}

.confirmation-card {
  max-width: 700px;
  margin: 3rem auto;
  text-align: center;
}

.confirmation-items {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
  margin: 1.2rem 0;
}

.confirmation-item {
  display: flex;
  justify-content: space-between;
  padding: 0.8rem 1rem;
  background: rgba(239, 231, 255, 0.35);
  border-radius: 12px;
}

.contact-layout {
  grid-template-columns: 0.9fr 1.1fr;
}

.social-links {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
}

.social-links a {
  background: var(--pink-100);
  padding: 0.55rem 0.8rem;
  border-radius: 999px;
  font-weight: 700;
}

.site-footer {
  background: #fffaf8;
  border-top: 1px solid rgba(50, 38, 50, 0.08);
  margin-top: 2rem;
}

.footer-grid {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}

.footer-grid ul {
  list-style: none;
  padding: 0;
  margin: 0;
  color: var(--text-700);
  line-height: 1.9;
}

@media (max-width: 920px) {
  .topbar {
    padding: 1rem 1.2rem;
    flex-wrap: wrap;
  }

  .nav-links {
    order: 3;
    width: 100%;
    justify-content: center;
  }

  .hero,
  .product-grid,
  .offer-grid,
  .testimonial-grid,
  .menu-grid,
  .cart-layout,
  .checkout-layout,
  .contact-layout,
  .modal-layout {
    grid-template-columns: 1fr;
  }

  .filters-row {
    grid-template-columns: 1fr;
  }

  .cart-item {
    grid-template-columns: 80px 1fr;
  }

  .quantity-control,
  .line-total,
  .remove-btn {
    justify-self: start;
  }
}
